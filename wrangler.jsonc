{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drawsprout",
  // The Worker script handles /api/* only. Static files, including dist/sw.js,
  // stay on the assets layer. Do not add the Cloudflare Vite plugin: it packages
  // assets before drawsproutOffline() writes sw.js, so /sw.js becomes HTML.
  // The date already on the deployed Worker. Node.js compatibility is the
  // default on or after 2026-08-04, so no compatibility_flags are set.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A missing file is index.html. A path that matches a file, including
    // /sw.js, is that file. See https://developers.cloudflare.com/workers/static-assets/routing/single-page-application/
    "not_found_handling": "single-page-application",
    // Only /api is handled by the script (photo-lesson and photo-match).
    // Everything else, including /sw.js and _headers, is served as a static asset.
    "run_worker_first": ["/api/*"]
  },
  // Workers Builds runs `wrangler preview` for a branch build. Previews do
  // not inherit top-level bindings. The paid gate reads env.PAID_RATE_LIMIT,
  // so the preview needs the same binding or every doodle is refused.
  // Secrets are not in this file. Set them once for new previews with
  // `npx wrangler preview base-config secret put REPLICATE_API_KEY`.
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "PAID_RATE_LIMIT", "class_name": "PaidRateLimit" }
      ]
    }
  },
  // Photo match. The key is the Worker secret REPLICATE_API_KEY, not a var.
  "vars": {
    "MATCH_PROVIDER": "replicate",
    "MATCH_REPLICATE_MODEL": "openai/gpt-4.1-mini"
  },
  // One strict 6-per-10-minutes window per client, shared by every isolate.
  // The Rate Limiting binding is per location, approximate, and only 10 or 60
  // seconds, so it cannot hold this budget. The class is exported from main.
  // The next deploy applies the migration. The dashboard is not used.
  "durable_objects": {
    "bindings": [
      { "name": "PAID_RATE_LIMIT", "class_name": "PaidRateLimit" }
    ]
  },
  "migrations": [
    { "tag": "v1-paid-rate-limit", "new_sqlite_classes": ["PaidRateLimit"] }
  ]
}
